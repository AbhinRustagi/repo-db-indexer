{
  "name": "repo-db-indexer",
  "version": "0.2.0",
  "description": "Build content indexes for git-native content repositories",
  "keywords": [
    "github-action",
    "static-site",
    "content",
    "index",
    "json-schema",
    "markdown",
    "frontmatter",
    "cli"
  ],
  "homepage": "https://github.com/AbhinRustagi/repo-db-indexer#readme",
  "bugs": {
    "url": "https://github.com/AbhinRustagi/repo-db-indexer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhinRustagi/repo-db-indexer.git"
  },
  "license": "MIT",
  "author": "Abhin Rustagi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "repo-db-indexer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
